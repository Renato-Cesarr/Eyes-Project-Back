# ==========================================
# EYES PROJECT - BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Aplicação
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Banco de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eyes_project_db
DB_USER=postgres
DB_PASSWORD=postgres

# Spring / Flyway
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Autenticação e Segurança (JWT)
# Use uma string longa e complexa para produção
JWT_SECRET=super_secret_key_for_local_development_only_eyes_project_2026
# Tempo de expiração em horas (ex: 24)
JWT_EXPIRATION_HOURS=24

# Frontend GUI Connection
FRONTEND_URL=http://localhost:4200

# E-mail (SMTP - Mailtrap/Local example)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=sua_user_key_aqui
SMTP_PASSWORD=sua_pass_key_aqui
SMTP_AUTH=true
SMTP_STARTTLS=true
